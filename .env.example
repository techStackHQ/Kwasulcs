# Copy this file to .env and fill in real values for local development:
#   cp .env.example .env
#
# Production (AlwaysData): this hosting plan has no env-var dashboard
# panel (confirmed — only PHP version + Custom php.ini are exposed), so
# production also uses a real .env file, deployed directly to the server
# and never committed. See .env.production.example for that template —
# a real process env var would still win over .env if this host ever
# gains one later (see includes/env.php's load_env()/env()).
#
# NEVER commit a real .env file — only this .env.example and
# .env.production.example (placeholders only) belong in version control.
# .gitignore already excludes .env and .env.*.

# ── Database ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ── AI providers (config.php's AI_PROVIDER constant picks which is used;
#    ANTHROPIC_API_KEY is only needed for the rollback path) ─────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
# platform.openai.com → API keys
OPENAI_API_KEY=sk-proj-your-key-here

# ── YouTube Data API v3 ──────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
# (enable "YouTube Data API v3" in the API Library first)
YOUTUBE_API_KEY=AIzaSy-your-key-here

# ── Google OAuth (Settings → Connected Accounts) ────────────────────────
# console.cloud.google.com → APIs & Services → Credentials →
# Create Credentials → OAuth client ID → Application type: Web application.
# GOOGLE_REDIRECT_URI must match an "Authorized redirect URI" entry on that
# client byte-for-byte (http vs https, trailing slash, everything) or
# Google rejects the callback with redirect_uri_mismatch. Leave
# GOOGLE_CLIENT_ID/SECRET unset to keep the feature harmlessly disabled.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost/LMS-portal/google_oauth_callback.php

# ── Google reCAPTCHA v3 ──────────────────────────────────────────────────
# google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# ── Gmail SMTP ────────────────────────────────────────────────────────────
# Use a Gmail App Password (Google Account → Security → 2-Step
# Verification → App Passwords) — NOT your real account login password.
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_EMAIL=your.email@gmail.com
